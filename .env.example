# ============================================================
# Oráculo Analista — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env no repositório!
# ============================================================

# --- Banco de Dados ---
DATABASE_URL=sqlite:///oraculo_analista.db

# --- LLM (Groq) ---
GROQ_API_KEY=sua_chave_groq_aqui

# --- Pagamentos (Asaas) ---
ASAAS_API_KEY=sua_chave_asaas_aqui
BASE_URL_ASAAS=https://api-sandbox.asaas.com/v3

# --- Pagamentos (Stripe) ---
API_KEY_STRIPE=sua_chave_stripe_aqui
STRIPE_WEBHOOK_SECRET=seu_webhook_secret_aqui

# --- Webhooks Make ---
WEBHOOK_TESTE=sua_url_webhook_teste
WEBHOOK_CADASTRO_ANALISTA=sua_url_webhook_cadastro

# --- FastAPI ---
FASTAPI_URL=http://localhost:8000

# -------------------------
# Hostinger Email (SMTP)
# -------------------------
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USERNAME=contato@oraculosia.site
EMAIL_PASSWORD=sua_senha_aqui
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_REMETENTE=contato@oraculosia.site
